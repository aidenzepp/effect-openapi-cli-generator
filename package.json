{
  "name": "effect-openapi-cli-generator",
  "version": "0.0.0",
  "private": true,
  "description": "Generate Effect-native CLIs from OpenAPI specifications and Effect HttpApi definitions.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "vp fmt --check",
    "lint": "vp lint --type-aware",
    "typecheck": "tsc --noEmit",
    "check": "bun tools/check-bun.ts && bun run format && bun run lint && bun run typecheck",
    "fix": "vp fmt && vp lint --fix"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "@hyperjump/json-schema": "1.18.0",
    "effect": "4.1.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "packageManager": "bun@1.4.3"
}
