{
  "name": "effect-openapi-cli-generator",
  "version": "0.0.0",
  "private": true,
  "description": "Generate Effect-native CLIs from OpenAPI specifications and Effect HttpApi definitions.",
  "license": "MIT",
  "bin": {
    "effect-openapi-cli-generator": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "format": "vp fmt --check",
    "lint": "vp lint --type-aware",
    "typecheck": "tsc --noEmit",
    "check": "bun run format && bun run lint && bun run typecheck",
    "fix": "vp fmt && vp lint --fix",
    "build": "tsc -p tsconfig.build.json",
    "test:integration": "bun test tests/integration.test.ts tests/package.test.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "effect": "4.0.3",
    "oxfmt": "0.70.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "packageManager": "bun@1.4.3"
}
