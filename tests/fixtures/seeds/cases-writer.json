{
  "cases": [
    {
      "id": "writer-nested-files-new-directory",
      "source": "E44 tests/write.test.ts writes nested files",
      "input": {
        "output": "absent",
        "application": {
          "files": [
            {
              "path": "src/main.ts",
              "content": "hello"
            }
          ]
        }
      },
      "expected": {
        "outcome": "written",
        "files": ["src/main.ts", "<manifest>"],
        "manifestWrittenLast": true,
        "lockRemovedAfter": true,
        "newPathsCreatedWith": "wx"
      },
      "designSection": "§3.6 Write"
    },
    {
      "id": "writer-existing-output-directory-allowed",
      "source": "E44 tests/write.test.ts refuses existing targets (flips: output directory also holds files the generator does not own)",
      "input": {
        "output": "directory-exists-with-author-files",
        "application": {
          "files": [
            {
              "path": "src/main.ts",
              "content": "hello"
            }
          ]
        },
        "authorFiles": ["dist/x.js", "node_modules/.keep", "src/commands.ts"]
      },
      "expected": {
        "outcome": "written",
        "priorOutcome": "rejected",
        "authorFilesUntouched": true,
        "generatedFilesReplacedAtomically": true,
        "rename": "temp-sibling-then-rename"
      },
      "designSection": "§3.6 Write"
    },
    {
      "id": "writer-regeneration-overwrites-generated-file",
      "source": "E44 tests/write.test.ts refuses existing targets (flips: generated files are overwritten on regeneration)",
      "input": {
        "output": "directory-with-previous-manifest",
        "application": {
          "files": [
            {
              "path": "src/main.ts",
              "content": "hello"
            }
          ]
        },
        "handEditedGeneratedFile": "src/main.ts"
      },
      "expected": {
        "outcome": "written",
        "priorOutcome": "rejected",
        "replacedBy": "rename-of-temp-sibling",
        "noPartialContentVisible": true
      },
      "designSection": "§3.6 Hand edits"
    },
