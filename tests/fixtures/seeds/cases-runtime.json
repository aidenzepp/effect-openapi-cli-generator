{
  "cases": [
    {
      "id": "multipart-file-bytes-and-filename",
      "source": "E46 tests/multipart.test.ts:132-182",
      "input": {
        "part": "document",
        "path": "dir/document.bin",
        "bytes": [0, 255, 128, 10, 13]
      },
      "expected": {
        "requestCount": 1,
        "contentTypePrefix": "multipart/form-data; boundary=",
        "partBytes": [0, 255, 128, 10, 13],
        "filename": "document.bin",
        "bodyIsSingleStream": true,
        "usesFormData": false
      },
      "designSection": "§6.3"
    },
    {
      "id": "multipart-filename-is-basename-not-path",
      "source": "E46 tests/multipart.test.ts:132-182",
      "input": {
        "part": "document",
        "path": "/home/operator/private/dir/report.pdf"
      },
      "expected": {
        "filename": "report.pdf",
        "filenameContainsDirectory": false
      },
      "designSection": "§6.3"
    },
    {
      "id": "multipart-stdin-filename-is-part-name",
      "source": "E46 design §6.3 (prior test had no stdin case)",
      "input": {
        "part": "document",
        "path": "-"
      },
      "expected": {
        "filename": "document"
      },
      "designSection": "§6.3"
    },
    {
      "id": "multipart-array-repeats-part-in-order",
      "source": "E46 tests/multipart.test.ts:132-182",
      "input": {
        "part": "attachments",
        "paths": ["a.bin", "b.txt"]
      },
      "expected": {
        "partCount": 2,
        "partName": "attachments",
        "partOrder": ["a.bin", "b.txt"]
      },
      "designSection": "§6.3"
    },
    {
      "id": "multipart-text-field-passes-as-given",
      "source": "E46 tests/multipart.test.ts:132-182",
      "input": {
        "part": "title",
        "value": "caption"
      },
      "expected": {
        "value": "caption",
        "hasFilename": false
      },
      "designSection": "§6.3"
    },
    {
      "id": "multipart-name-escapes-lf-cr-quote",
      "source": "E46 design §5 (spike S3 escaping rule)",
      "input": {
        "partName": "a\"b\nc\rd"
      },
      "expected": {
        "nameInHeader": "a%22b%0D%0Ac%0D%0Ad"
      },
      "designSection": "§5"
    },
    {
      "id": "multipart-filename-escapes-without-crlf-normalization",
      "source": "E46 design §5 (spike S3 escaping rule)",
      "input": {
        "filename": "x\"y\nz\rw"
      },
      "expected": {
        "filenameInHeader": "x%22y%0Az%0Dw"
      },
      "designSection": "§5"
    },
    {
      "id": "multipart-part-content-type-verbatim",
      "source": "E46 design §6.3 (Bun FormData appends a charset; the runtime must not)",
      "input": {
        "part": "meta",
        "encodingContentType": "application/json"
      },
      "expected": {
        "partContentType": "application/json"
      },
      "designSection": "§6.3"
    },
    {
      "id": "multipart-optional-body-omitted-sends-nothing-body",
      "source": "E46 tests/multipart.test.ts:184-247",
