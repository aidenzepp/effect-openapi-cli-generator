{
  "openapi": "3.1.0",
  "info": {
    "title": "Credential-like header parameters",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:9"
    }
  ],
  "paths": {
    "/params": {
      "get": {
        "operationId": "params-get",
        "parameters": [
          { "name": "X-Auth-Token", "in": "header", "schema": { "type": "string" } },
          {
            "name": "X-Pin",
            "in": "header",
            "schema": { "type": "string", "format": "password" }
          },
          {
            "name": "X-Hidden",
            "in": "header",
            "x-sensitive": true,
            "schema": { "type": "string" }
          },
          {
            "name": "X-Pins",
            "in": "header",
            "schema": { "type": "array", "items": { "type": "string", "format": "password" } }
          },
          {
            "name": "X-Shield",
            "in": "header",
            "schema": { "type": "string", "x-sensitive": true }
          },
          {
            "name": "X-Ref",
            "in": "header",
            "schema": { "$ref": "#/components/schemas/Tok" }
          },
          {
            "name": "X-Wrap",
            "in": "header",
            "schema": {
              "description": "A sensitive value",
              "allOf": [{ "$ref": "#/components/schemas/Tok" }]
            }
          },
          {
            "name": "X-Alias",
            "in": "header",
            "schema": { "$ref": "#/components/schemas/Alias" }
          },
          {
            "name": "X-Any",
            "in": "header",
            "schema": { "anyOf": [{ "$ref": "#/components/schemas/Tok" }] }
          },
          {
            "name": "X-One",
            "in": "header",
            "schema": { "oneOf": [{ "$ref": "#/components/schemas/Tok" }] }
          },
          { "name": "X-Request-Id", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/words": {
      "get": {
        "operationId": "words-get",
        "parameters": [
          { "name": "X-Hdr-ToKeN-Value", "in": "header", "schema": { "type": "string" } },
          { "name": "X-Hdr-SeCrEt-Value", "in": "header", "schema": { "type": "string" } },
          { "name": "X-Hdr-PaSsWoRd-Value", "in": "header", "schema": { "type": "string" } },
          { "name": "X-Hdr-PaSsWd-Value", "in": "header", "schema": { "type": "string" } },
          { "name": "X-Hdr-ApI-KeY-Value", "in": "header", "schema": { "type": "string" } },
          { "name": "X-Hdr-ApIkEy-Value", "in": "header", "schema": { "type": "string" } },
          { "name": "X-Hdr-ApI_kEy-Value", "in": "header", "schema": { "type": "string" } },
          { "name": "X-Hdr-AuTh-Value", "in": "header", "schema": { "type": "string" } },
          { "name": "X-Hdr-SeSsIoN-Value", "in": "header", "schema": { "type": "string" } },
          { "name": "X-Hdr-CrEdEnTiAl-Value", "in": "header", "schema": { "type": "string" } },
          { "name": "X-Hdr-SiGnAtUrE-Value", "in": "header", "schema": { "type": "string" } },
          { "name": "X-Request-Id", "in": "header", "schema": { "type": "string" } },
          { "name": "R2-Access-Key-Id", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/upload": {
      "post": {
        "operationId": "upload-post",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": { "note": { "type": "string" } }
              },
              "encoding": {
                "note": {
                  "contentType": "text/plain",
                  "headers": {
                    "X-Part-Token": { "schema": { "type": "string" } },
                    "X-Part-Pin": { "schema": { "type": "string", "format": "password" } },
                    "X-Part-Hidden": { "x-sensitive": true, "schema": { "type": "string" } },
                    "X-Part-Shield": { "schema": { "type": "string", "x-sensitive": true } },
                    "X-Part-Ref": { "schema": { "$ref": "#/components/schemas/Tok" } },
                    "X-Part-Wrap": {
                      "schema": { "allOf": [{ "$ref": "#/components/schemas/Tok" }] }
                    },
                    "X-Part-Alias": { "schema": { "$ref": "#/components/schemas/Alias" } },
                    "X-Part-Any": {
                      "schema": { "anyOf": [{ "$ref": "#/components/schemas/Tok" }] }
                    },
                    "X-Part-One": {
                      "schema": { "oneOf": [{ "$ref": "#/components/schemas/Tok" }] }
                    },
                    "X-Part-Trace": { "schema": { "type": "string" } }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Tok": { "type": "string", "x-sensitive": true },
      "Alias": { "$ref": "#/components/schemas/Tok" }
    }
  }
}
