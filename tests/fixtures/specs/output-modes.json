{
  "openapi": "3.1.0",
  "info": {
    "title": "Output modes fixture: --dry-run, --verbose and --error-format json",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": { "port": { "default": "80" } }
    }
  ],
  "security": [{ "token": [] }],
  "paths": {
    "/widgets": {
      "post": {
        "tags": ["widgets"],
        "operationId": "widgets-create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "size": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created widget.",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/widgets/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "tags": ["widgets"],
        "operationId": "widgets-get",
        "parameters": [
          { "name": "X-Trace", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The widget.",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "404": {
            "description": "No such widget.",
            "headers": {
              "X-Request-Id": {
                "description": "The server's id for this request.",
                "schema": { "type": "string" }
              }
            },
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/status": {
      "get": {
        "tags": ["status"],
        "operationId": "status-get",
        "security": [],
        "responses": {
          "200": {
            "description": "The service status.",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "token": { "type": "http", "scheme": "bearer" }
    }
  }
}
