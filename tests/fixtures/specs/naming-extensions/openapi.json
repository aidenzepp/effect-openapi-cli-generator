{
  "info": { "title": "Naming extensions", "version": "1.0.0" },
  "openapi": "3.1.1",
  "paths": {
    "/accounts/{account_id}/members": {
      "get": {
        "operationId": "listAccountMembers",
        "parameters": [
          { "in": "path", "name": "account_id", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } },
        "x-forge-group-name": "accounts.members",
        "x-forge-method-name": "list"
      }
    },
    "/dns/records": {
      "post": {
        "operationId": "createDnsRecord",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "properties": { "priority": { "type": "integer" } }, "type": "object" }
            }
          }
        },
        "responses": { "200": { "description": "ok" } },
        "x-forge-group-name": ["dns", "records"],
        "x-forge-method-name": "create"
      }
    },
    "/invoices/{id}": {
      "get": {
        "operationId": "invoiceFetch",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } },
        "x-fern-sdk-group-name": "billing",
        "x-fern-sdk-method-name": "getInvoice"
      }
    },
    "/jobs/{id}": {
      "delete": {
        "operationId": "deleteJob",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } },
        "tags": ["jobs"],
        "x-forge-hidden": true,
        "x-forge-require-confirmation": true,
        "x-speakeasy-retries": {
          "backoff": {
            "exponent": 2,
            "initialInterval": 10,
            "maxElapsedTime": 1000,
            "maxInterval": 100
          },
          "retryConnectionErrors": true,
          "statusCodes": ["503"],
          "strategy": "backoff"
        }
      }
    },
    "/labels": {
      "get": {
        "operationId": "labelsIndex",
        "responses": { "200": { "description": "ok" } },
        "x-forge-group-name": "labels",
        "x-forge-method-name": "list"
      }
    },
    "/labels/archive": {
      "get": {
        "operationId": "archiveLabels",
        "responses": { "200": { "description": "ok" } },
        "tags": ["archive"],
        "x-forge-aliases": [{ "x-forge-group-name": "labels", "x-forge-method-name": "list" }]
      }
    },
    "/people/{id}": {
      "get": {
        "operationId": "personGet",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } },
        "x-fern-sdk-group-name": "people",
        "x-fern-sdk-method-name": "fetchPerson",
        "x-forge-group-name": "users",
        "x-forge-method-name": "show"
      }
    },
    "/pets": {
      "get": {
        "operationId": "listPets",
        "responses": { "200": { "description": "ok" } },
        "tags": ["pets"]
      }
    },
    "/projects/{name}": {
      "put": {
        "operationId": "renameProject",
        "parameters": [
          { "in": "path", "name": "name", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "properties": { "name": { "type": "string" } }, "type": "object" }
            }
          }
        },
        "responses": { "200": { "description": "ok" } },
        "tags": ["projects"]
      }
    },
    "/reports": {
      "get": {
        "operationId": "listReports",
        "responses": { "200": { "description": "ok" } },
        "tags": ["reports"],
        "x-forge-group-name": 42
      }
    },
    "/widgets/{id}": {
      "get": {
        "operationId": "getWidget",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } },
        "tags": ["widgets"],
        "x-forge-aliases": [{ "x-forge-group-name": "gadgets", "x-forge-method-name": "fetch" }]
      }
    },
    "/zones/{zone_id}": {
      "patch": {
        "operationId": "editZone",
        "parameters": [
          { "in": "path", "name": "zone_id", "required": true, "schema": { "type": "string" } },
          { "in": "query", "name": "dry", "schema": { "type": "boolean" } },
          { "in": "header", "name": "X-Trace", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": { "paused": { "type": "boolean" }, "ttl": { "type": "integer" } },
                "type": "object"
              }
            }
          }
        },
        "responses": { "200": { "description": "ok" } },
        "x-forge-aliases": [
          { "x-forge-group-name": "dns", "x-forge-method-name": "edit-zone" },
          { "x-fern-sdk-group-name": "legacy", "x-fern-sdk-method-name": "updateZone" }
        ],
        "x-forge-group-name": "zones",
        "x-forge-method-name": "edit"
      }
    }
  },
  "servers": [{ "url": "http://127.0.0.1:{port}", "variables": { "port": { "default": "80" } } }]
}
