{
  "openapi": "3.1.0",
  "info": { "title": "Proxy loopback fixture", "version": "1.0.0" },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": { "port": { "default": "80" } }
    }
  ],
  "paths": {
    "/hops/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "tags": ["hops"],
        "operationId": "hops-get",
        "security": [{ "bearer": [], "key": [] }],
        "responses": {
          "200": {
            "description": "Landed.",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "description": "A bearer token." },
      "key": { "type": "apiKey", "in": "header", "name": "X-Api-Key", "description": "An API key." }
    }
  }
}
