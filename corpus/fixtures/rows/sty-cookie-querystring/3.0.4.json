{
  "components": {
    "securitySchemes": {
      "cookieKey": {
        "in": "cookie",
        "name": "token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Cookie, querystring and style rows witness",
    "version": "1.0.0"
  },
  "openapi": "3.0.4",
  "paths": {
    "/auth-cookies": {
      "get": {
        "operationId": "auth-cookies-get",
        "parameters": [
          {
            "in": "cookie",
            "name": "session",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "security": [
          {
            "cookieKey": []
          }
        ]
      }
    },
    "/cookies": {
      "get": {
        "operationId": "cookies-get",
        "parameters": [
          {
            "in": "cookie",
            "name": "session",
            "schema": {
              "type": "string"
            }
          },
          {
            "explode": false,
            "in": "cookie",
            "name": "theme",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "search-get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "80"
        }
      }
    }
  ]
}
