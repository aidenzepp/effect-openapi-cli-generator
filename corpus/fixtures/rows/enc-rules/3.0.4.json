{
  "info": {
    "title": "Encoding rule rows witness",
    "version": "1.0.0"
  },
  "openapi": "3.0.4",
  "paths": {
    "/declared": {
      "post": {
        "operationId": "declared-upload",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "encoding": {
                "file": {
                  "headers": {
                    "Content-Transfer-Encoding": {
                      "schema": {
                        "enum": ["base64"],
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "schema": {
                "properties": {
                  "file": {
                    "format": "byte",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "done"
          }
        }
      }
    },
    "/form": {
      "post": {
        "operationId": "form-create",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "data": {
                    "format": "byte",
                    "type": "string"
                  },
                  "gone": {
                    "nullable": true,
                    "type": "string"
                  },
                  "meta": {
                    "properties": {
                      "a": {
                        "type": "string"
                      },
                      "b": {
                        "type": "integer"
                      }
                    },
                    "type": "object"
                  },
                  "name": {
                    "type": "string"
                  },
                  "tags": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "zone": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "done"
          }
        }
      }
    },
    "/names": {
      "post": {
        "operationId": "names-upload",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "doc": {
                    "format": "binary",
                    "type": "string"
                  },
                  "naïve": {
                    "type": "string"
                  },
                  "x\"y": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "done"
          }
        }
      }
    },
    "/parts": {
      "post": {
        "operationId": "parts-upload",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "bin": {
                    "format": "binary",
                    "type": "string"
                  },
                  "blob": {},
                  "byte": {
                    "format": "byte",
                    "type": "string"
                  },
                  "count": {
                    "type": "integer"
                  },
                  "files": {
                    "items": {
                      "format": "binary",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "flag": {
                    "type": "boolean"
                  },
                  "meta": {
                    "properties": {
                      "a": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "note": {
                    "type": "string"
                  },
                  "nums": {
                    "items": {
                      "type": "integer"
                    },
                    "type": "array"
                  },
                  "ratio": {
                    "type": "number"
                  },
                  "tags": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "done"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "80"
        }
      }
    }
  ]
}
