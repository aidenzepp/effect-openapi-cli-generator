{
  "openapi": "3.1.0",
  "info": {
    "title": "Users Reference",
    "version": "1.0.0",
    "description": "Inspect user accounts through the Users API."
  },
  "paths": {
    "/users": {
      "get": {
        "operationId": "users-list",
        "x-fern-sdk-group-name": "users",
        "x-fern-sdk-method-name": "list",
        "summary": "List users",
        "responses": {
          "200": {
            "description": "Local JSON response"
          },
          "404": {
            "description": "The users collection is unavailable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "description": "Human-readable details about an HTTP problem.",
                  "properties": {
                    "detail": {
                      "type": "string",
                      "description": "An explanation specific to this occurrence."
                    },
                    "title": {
                      "type": "string",
                      "description": "A short summary of the problem."
                    }
                  }
                },
                "example": {
                  "title": "Users unavailable.",
                  "detail": "The requested team has no users collection."
                }
              }
            }
          },
          "503": {
            "description": "The service is temporarily unavailable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "description": "Human-readable details about an HTTP problem.",
                  "properties": {
                    "detail": {
                      "type": "string",
                      "description": "An explanation specific to this occurrence."
                    },
                    "title": {
                      "type": "string",
                      "description": "A short summary of the problem."
                    }
                  }
                },
                "example": {
                  "title": "Maintenance is in progress."
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "active",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Return only active users when true or inactive users when false. Omit to return all users."
          }
        ],
        "description": "Return users, optionally filtered by whether their accounts are active.",
        "tags": ["users"]
      }
    }
  },
  "tags": [
    {
      "name": "users",
      "description": "Browse user accounts."
    }
  ]
}
